# ============================================
# Luvio Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================

# --- Node ---
NODE_ENV=development

# --- Database (Cloudflare D1) ---
D1_DATABASE_ID=
D1_DATABASE_NAME=luvio-db

# --- Authentication ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# --- OTP (SMS Provider) ---
OTP_SERVICE_API_KEY=
OTP_SERVICE_URL=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple OAuth ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Storage (Cloudflare R2) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=luvio-uploads
R2_PUBLIC_URL=

# --- Maps ---
MAPBOX_ACCESS_TOKEN=

# --- Push Notifications ---
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Public Variables (exposed to browser) ---
NEXT_PUBLIC_API_URL=http://localhost:2223/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:2223/ws
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_NAME=Luvio
NEXT_PUBLIC_APP_URL=http://localhost:2222
