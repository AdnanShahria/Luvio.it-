{
  "name": "luvio-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Luvio — Neighborhood marketplace & community platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "type-check": "tsc --noEmit --project frontend/tsconfig.json && tsc --noEmit --project backend/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "validate:env": "npx tsx scripts/validate-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx backend/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "deploy": "npm run validate:env && npm run build && wrangler pages deploy frontend/.next",
    "clean": "rimraf node_modules frontend/.next frontend/node_modules backend/node_modules shared/node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.22.0",
    "rimraf": "^5.0.7",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
